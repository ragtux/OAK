      ["move", 46, 18], ["click"], ["wait", 1000], ["shot", "main-menu"], ["key", "escape"], ["wait", 500],
      ["key", "ctrl+shift+f"], ["wait", 1500], ["shot", "search"],
      ["type", "Record"], ["wait", 2500], ["shot", "search-typed"], ["key", "escape"], ["wait", 500],
      ["key", "ctrl+shift+h"], ["wait", 1500], ["shot", "replace"], ["key", "escape"], ["wait", 500],
      ["move", 100, 478], ["click"], ["wait", 800], ["key", "shift+delete"], ["wait", 1200], ["shot", "delete-dialog"], ["key", "escape"], ["wait", 500],
      ["key", "ctrl+alt+w"], ["wait", 1500], ["shot", "recent-workspaces"], ["key", "escape"], ["wait", 500]
