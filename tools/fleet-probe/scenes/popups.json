    "oak": [
      ["wait", 1000],
      ["move", 100, 139], ["click", "right"], ["wait", 600], ["shot", "tree-menu"], ["key", "escape"], ["wait", 400],
      ["move", 430, 56], ["click", "right"], ["wait", 600], ["shot", "tab-menu"], ["key", "escape"], ["wait", 400],
      ["move", 700, 300], ["click", "right"], ["wait", 600], ["shot", "editor-menu"], ["key", "escape"], ["wait", 400],
      ["move", 46, 18], ["click"], ["wait", 600], ["shot", "main-menu"], ["key", "escape"], ["wait", 400],
      ["key", "ctrl+shift+f"], ["wait", 800], ["shot", "search"],
      ["type", "Record"], ["wait", 1500], ["shot", "search-typed"], ["key", "escape"], ["wait", 400],
      ["key", "ctrl+shift+h"], ["wait", 800], ["shot", "replace"], ["key", "escape"], ["wait", 400],
      ["move", 100, 478], ["click"], ["wait", 600], ["key", "shift+delete"], ["wait", 800], ["shot", "delete-dialog"], ["key", "escape"], ["wait", 400],
      ["key", "ctrl+alt+w"], ["wait", 800], ["shot", "recent-workspaces"], ["key", "escape"], ["wait", 400]
