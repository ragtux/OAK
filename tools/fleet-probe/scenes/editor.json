{
  "name": "editor",
  "about": "The M0 reference scene: the fixture workspace open, src/main.rs in the editor, caret on line 1, nothing else. Batches 1 and 3 in docs/probe-plan.md.",
  "size": [1280, 800],
  "pos": [100, 100],
  "settle_ms": 6000,
  "manual": [
    "Fleet: if the Trust dialog shows, the steps press Escape, which keeps Smart Mode off (Preview).",
    "Fleet: src/main.rs is opened through Goto; the caret is sent to line 1."
  ],
  "steps": {
    "fleet": [
      ["wait", 2000],
      ["key", "escape"],
      ["wait", 500],
      ["key", "ctrl+k"],
      ["wait", 800],
      ["type", "main.rs"],
      ["wait", 1500],
      ["key", "enter"],
      ["wait", 2000],
      ["key", "ctrl+home"],
      ["wait", 800],
      ["shot", "editor"]
    ],
    "oak": [
      ["wait", 1000],
      ["shot", "editor"]
    ]
  },
  "oak_args": ["{workspace}/src/main.rs"],
  "scans": [
    {"name": "left island column (left of the chevrons, below the toolbar)", "axis": "y", "at": 18.67, "edges": ["island top", "Files tab top", "Files tab bottom", "root row top", "root row bottom"], "from": 30},
    {"name": "editor island column (clear of text)", "axis": "y", "at": 1000, "edges": ["island top", "current line top", "current line bottom", "island bottom"]},
    {"name": "tab row", "axis": "x", "at": 56, "to": 700, "edges": ["island left", "Files tab left", "Files tab right"]},
    {"name": "root row", "axis": "x", "at": 87.33, "to": 400, "edges": ["island left", "root row left"]},
    {"name": "line 2 (blank)", "axis": "x", "at": 109, "from": 300, "edges": ["left island right", "editor island left"]}
  ],
  "samples": [
    {"name": "window background", "at": [4, 400], "key": "background.primary"},
    {"name": "left island", "at": [200, 700], "key": "island.background"},
    {"name": "editor island", "at": [1000, 109], "key": "editor.background"},
    {"name": "status bar", "at": [640, 790], "key": "statusBar.background"},
    {"name": "toolbar", "at": [600, 6], "key": "background.primary"}
  ]
}
