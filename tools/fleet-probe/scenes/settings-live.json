{
  "name": "settings-live",
  "about": "WEEP only: the settings file changes while the editor runs (theme, zoomLevel, editor.fontSize) and the window follows within a second, as Fleet's does. Fleet's own reload is not probed here.",
  "size": [1280, 800],
  "pos": [100, 100],
  "settle_ms": 3000,
  "steps": {
    "weep": [
      ["wait", 500],
      ["shot", "before"],
      ["weep-settings", {"theme": "light"}],
      ["wait", 2500],
      ["shot", "light"],
      ["weep-settings", {"theme": "light", "zoomLevel": 1.5}],
      ["wait", 2500],
      ["shot", "zoom"],
      ["weep-settings", {"editor.fontSize": 16}],
      ["wait", 2500],
      ["shot", "font"],
      ["key", "ctrl+minus"],
      ["wait", 800],
      ["shot", "zoom-out"]
    ]
  },
  "weep_args": ["{workspace}/src/main.rs"],
  "scans": [],
  "samples": []
}
